FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      avr-libc \
      avrdude \
      avarice \
      binutils-avr \
      ca-certificates \
      gcc \
      gcc-avr \
      gdb-avr \
      git \
      libelf-dev \
      libsimavr-dev \
      make \
      simavr \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["bash"]
